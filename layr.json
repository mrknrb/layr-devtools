{
  "id": "devtools",
  "name": "My plugins",
  "version": "0.1.2",
  "description": "Plugins you made or changed: their history with undo, versions and updates, and sharing them on GitHub.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "history",
  "permissions": ["data", "packages"],
  "connections": [
    { "plugin": "claude", "groups": ["run"],
      "why": "Change it with Claude and Combine with Claude: starts a Claude thread in the plugin's folder" }
  ],
  "panels": [
    { "id": "main", "title": "My plugins", "page": "panels/main.html", "icon": "history", "single": true }
  ],
  "commands": [
    { "id": "open", "title": "My plugins", "panel": "main" },
    { "id": "github", "title": "My plugins: GitHub", "panel": "main", "params": { "view": "github" } }
  ],
  "menus": [
    { "menu": "Tools", "command": "open", "group": "8" },
    { "menu": "Tools", "command": "github", "group": "8" }
  ]
}
